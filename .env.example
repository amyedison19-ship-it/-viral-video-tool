# Google Gemini API Key for video analysis
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Volcengine ARK API Key for Jimeng (Seedance) video generation
# Get your key at: https://console.volcengine.com/ark
ARK_API_KEY=your-ark-api-key-here

# Vercel Blob token for uploading large videos (> 4MB)
# Created automatically in Vercel dashboard when you add Blob storage
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here
